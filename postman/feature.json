				{
					"name": "Поиск событий рядом с UserLocation",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const main = async () => {",
									"    try {",
									"        ",
									"        const lat = 50.0;",
									"        const lon = 60.0;",
									"       ",
									"        const api = new API(pm);",
									"        const rnd = new RandomUtils();",
									"        ",
									"        const user = await api.addUser(rnd.getUser());",
									"        const category = await api.addCategory(rnd.getCategory());",
									"        const timestamp = Date.now().toString().slice(-6);",
									"        const locationName = `Парк ${timestamp}`;",
									"        ",
									"        const locationData = {",
									"            name: locationName,",
									"            latitude: lat,",
									"            longitude: lon,",
									"            radius: 0.05,",
									"            type: \"OPEN_AIR\"",
									"        };",
									"        ",
									"        let location;",
									"        try {",
									"            location = await api.addLocation(locationData);",
									"        } catch (err) {",
									"            return;",
									"        }",
									"    ",
									"        const createdEventIds = [];",
									"    ",
									"        const event1 = await api.addEvent(user.id, {",
									"            ...rnd.getEvent(category.id),",
									"            title: \"Событие рядом 1\",",
									"            location: { ",
									"                lat: lat + 0.0001,",
									"                lon: lon + 0.0001",
									"            }",
									"        });",
									"        createdEventIds.push(event1.id);",
									"        ",
									"        try {",
									"            await api.publishEvent(event1.id);",
									"        } catch (err) {",
									"            console.log(`${err.message}`);",
									"        }",
									"        ",
									"        const event2 = await api.addEvent(user.id, {",
									"            ...rnd.getEvent(category.id),",
									"            title: \"Событие рядом 2\",",
									"            location: { ",
									"                lat: lat - 0.0002,",
									"                lon: lon - 0.0001",
									"            }",
									"        });",
									"       ",
									"        createdEventIds.push(event2.id);",
									"        ",
									"        try {",
									"            await api.publishEvent(event2.id);",
									"        } catch (err) {",
									"            console.log(`${err.message}`);",
									"        }",
									"        ",
									"        pm.environment.set(\"test_lat\", lat.toString());",
									"        pm.environment.set(\"test_lon\", lon.toString());",
									"        pm.environment.set(\"test_location_id\", location.id.toString());",
									"        pm.environment.set(\"created_event_ids\", createdEventIds.join(\",\"));",
									"        ",
									"    } catch(err) {",
									"        console.error(err.message);",
									"    }",
									"};",
									"",
									"main();"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Ответ должен содержать код статуса 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Ответ должен содержать массив событий\", function () {",
									"    const response = pm.response.json();",
									"    ",
									"    pm.expect(response).to.be.an('array');",
									"    const eventCount = response.length;",
									"    pm.expect(eventCount).to.be.at.least(1);",
									"    ",
									"});",
									"",
									"pm.test(\"Широта пользователя должна быть валидной\", function () {",
									"    const lat = parseFloat(pm.request.url.query.get('lat'));",
									"    pm.expect(lat).to.be.within(-90, 90);",
									"});",
									"",
									"pm.test(\"Долгота пользователя должна быть валидной\", function () {",
									"    const lon = parseFloat(pm.request.url.query.get('lon'));",
									"    pm.expect(lon).to.be.within(-180, 180);",
									"});",
									"",
									"pm.test(\"События должны находиться в пределах 1 км от пользователя\", function () {",
									"    const response = pm.response.json();",
									"    const userLat = parseFloat(pm.request.url.query.get('lat'));",
									"    const userLon = parseFloat(pm.request.url.query.get('lon'));",
									"    const radius = parseFloat(pm.request.url.query.get('radius')) || 1.0;",
									"    ",
									"    response.forEach((event, index) => {",
									"        // Используем упрощенную формулу для быстрого расчета",
									"        // 1 градус широты ≈ 111 км, 1 градус долготы ≈ 111 * cos(широта) км",
									"        const latDiffKm = (event.location.lat - userLat) * 111;",
									"        const lonDiffKm = (event.location.lon - userLon) * 111 * Math.cos(userLat * Math.PI / 180);",
									"        const distanceKm = Math.sqrt(latDiffKm * latDiffKm + lonDiffKm * lonDiffKm);",
									"        ",
									"        pm.expect(distanceKm).to.be.lessThan(radius);",
									"    });",
									"    ",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
